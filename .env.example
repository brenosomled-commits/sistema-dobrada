# Obrigatório em produção: gere um valor longo e aleatório.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Usado somente para criar o primeiro usuário admin em um banco novo.
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Desenvolvimento local opcional.
SQLITE_DATABASE=ordens.db

# PRODUÇÃO (Vercel/Neon): quando esta variável estiver presente, o app usa
# PostgreSQL (Neon) em vez de SQLite. Ela é injetada automaticamente pela
# integração Neon no Vercel. Formato:
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require
